<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER" prefHeight="549.0" prefWidth="653.0" spacing="20.0"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="edu.bsu.cs222.project2menu.TaskListController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label fx:id="welcomeText" text="Task List Creator" />
   <Separator prefHeight="34.0" prefWidth="457.0" />
   <Label text="Input Task" />
   <TextField fx:id="taskInputField"/>
   <Label text="Day and Time" />
   <HBox prefHeight="25.0" prefWidth="457.0">
      <children>
         <ChoiceBox fx:id="dayChoiceBox" prefHeight="25.0" prefWidth="257.0" />
         <ChoiceBox fx:id="hourChoiceBox" prefHeight="25.0" prefWidth="264.0" />
         <ChoiceBox fx:id="minuteChoiceBox" prefHeight="25.0" prefWidth="251.0" />
      </children>
   </HBox>
   <BorderPane prefHeight="54.0" prefWidth="327.0">
      <right>
         <Button fx:id="clearButton" onAction="#clearList" text="Clear List"/>
      </right>
      <left>
         <Button fx:id="inputButton" onAction="#printInput" text="Enter Input"/>
      </left>
   </BorderPane>
    <Button fx:id="screenshotButton" onAction="#listScreenshot" text="Screenshot" />
</VBox>
